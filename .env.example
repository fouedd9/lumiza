# Public Supabase project URL (Project Settings > API).
# Required for Step 3 checkout. The landing still works without it.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable Supabase key. Safe for browser use when Row Level Security is enabled.
# Do not put a service role or secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key used for atomic commerce RPCs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Authoritative site origin for checkout return URLs and API origin checks.
# Use an HTTPS origin in production or http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=

# Explicit in production. Omitted mode defaults to TEST only in local development.
# Mode, secret key, publishable key, sessions and webhook events must agree.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Required in production for authorized reconciliation; optional locally.
# Vercel Cron sends this value in an Authorization: Bearer header when configured.
# Use a private cron_-prefixed value of at least 37 characters; never NEXT_PUBLIC_.
CRON_SECRET=

# No email provider is configured in Step 4. The provider adapter is disabled.
# Future provider credentials must be server-only; do not add them to NEXT_PUBLIC_*.
